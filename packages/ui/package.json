    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "react-native-safe-area-context": "5.4.0"
  },
  "type": "module",
  "files": [
    "dist"
  ]
