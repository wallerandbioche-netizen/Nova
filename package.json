{
  "name": "nova",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA \u2014 votre copilote personnel pour comprendre vos investissements",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "bootstrap": "node scripts/setup.mjs",
    "dev": "pnpm build:packages && pnpm --parallel --no-bail --filter @nova/api --filter @nova/mobile dev",
    "dev:api": "pnpm build:packages && pnpm --filter @nova/api dev",
    "dev:mobile": "pnpm build:packages && pnpm --filter @nova/mobile start",
    "verify": "node scripts/doctor.mjs",
    "build": "pnpm build:packages && pnpm --filter @nova/api build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\"",
    "test": "pnpm build:packages && pnpm -r test",
    "test:unit": "pnpm build:packages && pnpm -r test:unit",
    "test:integration": "pnpm build:packages && pnpm --filter @nova/api test:integration",
    "db:generate": "pnpm --filter @nova/api db:generate",
    "db:migrate": "pnpm --filter @nova/api db:migrate",
    "db:seed": "pnpm --filter @nova/api db:seed",
    "demo:reset": "pnpm --filter @nova/api db:seed",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "dev:offline": "EXPO_OFFLINE=1 pnpm dev",
    "dev:web": "pnpm --filter @scantrade/web dev",
    "build:web": "pnpm --filter @scantrade/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
