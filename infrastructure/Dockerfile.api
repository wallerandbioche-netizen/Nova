# NOVA API image.
#
# Multi-stage: the build stage compiles the workspace packages and the API; the runtime stage
# ships only production dependencies and the compiled output, and runs as a non-root user.
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @nova/api exec prisma generate
RUN pnpm build:packages && pnpm --filter @nova/api build

FROM base AS runtime
ENV NODE_ENV=production
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY packages ./packages
COPY apps/api/package.json ./apps/api/
COPY apps/api/prisma ./apps/api/prisma
RUN pnpm install --frozen-lockfile --prod --ignore-scripts \
  && pnpm --filter @nova/api exec prisma generate

COPY --from=build /app/packages/types/dist ./packages/types/dist
COPY --from=build /app/packages/validation/dist ./packages/validation/dist
COPY --from=build /app/packages/config/dist ./packages/config/dist
COPY --from=build /app/packages/finance/dist ./packages/finance/dist
COPY --from=build /app/apps/api/dist ./apps/api/dist

# Run unprivileged: a compromised process should not own the filesystem.
USER node
EXPOSE 4000

# The container answers readiness itself, so an orchestrator can stop routing to a broken pod.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

WORKDIR /app/apps/api
CMD ["node", "dist/server.js"]
