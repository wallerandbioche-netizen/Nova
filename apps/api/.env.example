# ---------------------------------------------------------------------------
# NOVA — example environment file.
# Copy to .env and fill in. NEVER commit a real .env: it is git-ignored.
# No secret below is ever exposed to the mobile client.
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of origins allowed to call the API (web build, tooling).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=info

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova_dev?schema=public
# Used only by integration tests; must point to a database you can wipe.
TEST_DATABASE_URL=postgresql://nova:nova@localhost:5432/nova_test?schema=public

# --- Cache & jobs --------------------------------------------------------
# Optional in development: without it NOVA falls back to an in-memory cache and
# an in-process scheduler, so the app runs with no extra infrastructure.
REDIS_URL=

# --- Authentication ------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# --- Rate limiting (per window, per IP unless stated) ---------------------
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW=1 minute
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=15 minutes
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=15 minutes
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW=1 hour
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW=1 hour

# --- Providers -----------------------------------------------------------
# Each provider accepts "demo" (deterministic, clearly labelled demonstration data)
# or the name of a real implementation. See docs/08-providers.md to plug a real one.

# market data: demo | http
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

# news: demo | http
NEWS_PROVIDER=demo
NEWS_API_URL=
NEWS_API_KEY=

# llm: demo | anthropic | openai-compatible
LLM_PROVIDER=demo
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=1200

# transactional mail: log | http
# "log" writes the message to the logs and delivers nothing — development only.
# Production refuses to start on "log" so a password reset can never silently fail.
MAIL_PROVIDER=log
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=NOVA <no-reply@nova.app>
APP_DEEP_LINK_BASE=nova://

# notifications: demo | expo
NOTIFICATION_PROVIDER=demo
EXPO_ACCESS_TOKEN=

# payments: none | stripe
PAYMENT_PROVIDER=none
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PREMIUM_PRICE_ID=

# storage: local | s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# analytics: none | http  (never receives amounts, holdings or identities)
ANALYTICS_PROVIDER=none
ANALYTICS_API_URL=
ANALYTICS_API_KEY=

# --- Jobs ----------------------------------------------------------------
# Cron expression for the daily brief pipeline, in the timezone below.
DAILY_BRIEF_CRON=0 6 * * *
JOBS_TIMEZONE=Europe/Paris
# Set to false on an API instance that must not run background jobs.
JOBS_ENABLED=true
