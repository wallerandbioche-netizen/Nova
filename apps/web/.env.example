# SCAN TRADE — web application
#
# Every value below is optional: without credentials the app runs entirely on
# its deterministic engine and simulated market data. Never commit real keys.

# Reasoning layer. When set, the narrative sections are rewritten by the model
# and chart screenshots can be read by its vision capability. All prices,
# levels and scores still come from the local engine.
ANTHROPIC_API_KEY=

# Optional model override for the reasoning layer.
SCANTRADE_MODEL=claude-sonnet-5
