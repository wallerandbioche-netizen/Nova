# SCAN TRADE — application web
#
# Tout est optionnel : sans aucune variable, l'application tourne en mode
# démonstration (moteur d'analyse complet, données simulées, abonnement simulé).
# Ne committez jamais de vraie clé.

# ─── Lecture des captures d'écran ────────────────────────────────────────────
# Sans cette clé, l'analyse d'image répond « données visuelles insuffisantes »
# au lieu d'inventer des valeurs.
ANTHROPIC_API_KEY=
# Modèle utilisé pour la rédaction et la lecture d'image (optionnel).
SCANTRADE_MODEL=claude-sonnet-5

# ─── Comptes utilisateurs ────────────────────────────────────────────────────
# Base Postgres (Neon, Supabase, Vercel Postgres…). Les tables sont créées
# automatiquement au premier appel.
DATABASE_URL=
# Secret de signature des sessions : une chaîne aléatoire longue.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Envoi du lien de connexion (https://resend.com). Sans clé, le lien est écrit
# dans les journaux du serveur au lieu d'être envoyé.
RESEND_API_KEY=
EMAIL_FROM="SCAN TRADE <onboarding@resend.dev>"

# ─── Paiements ───────────────────────────────────────────────────────────────
# Clé secrète Stripe, puis les deux tarifs créés par scripts/stripe-setup.mjs.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Secret du webhook (Stripe → Developers → Webhooks → Signing secret).
STRIPE_WEBHOOK_SECRET=

# ─── Adresse publique ────────────────────────────────────────────────────────
# Utilisée par les redirections Stripe et les liens de connexion. Sur Vercel
# elle est déduite automatiquement.
NEXT_PUBLIC_APP_URL=
