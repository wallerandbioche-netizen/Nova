# ---------------------------------------------------------------------------
# Scan Trade — example environment file.
# Copy to `.env` and fill in. `.env` is git-ignored: never commit real keys.
# Every variable below is server-side only. Nothing here is exposed to the
# browser (no NEXT_PUBLIC_* secret exists in this project).
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
# Public origin of the app. Used for Stripe redirects and password-reset links.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (PostgreSQL) ----------------------------------------------
DATABASE_URL=postgresql://scan_trade:scan_trade@localhost:5432/scan_trade?schema=public

# --- Authentication (Auth.js) -------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=
# Optional. Required only behind a proxy that rewrites the host header.
AUTH_URL=

# Optional Google sign-in. Leave both empty to disable the provider entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI provider ---------------------------------------------------------
# Only "anthropic" is implemented. Add a provider in src/lib/ai/providers/.
AI_PROVIDER=anthropic
# Without this key, /api/analyses/:id/scan fails with a clear configuration
# error. The app never falls back to a simulated analysis.
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_BASE_URL=https://api.anthropic.com
AI_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=4096

# --- Object storage ------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR (development only).
# "s3" targets any S3-compatible private bucket: AWS S3, Cloudflare R2,
# Supabase Storage (S3 endpoint), MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage

STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Required by R2, MinIO and Supabase; harmless on AWS S3.
STORAGE_FORCE_PATH_STYLE=true
# Lifetime of the signed URLs handed to the browser, in seconds (30–3600).
STORAGE_SIGNED_URL_TTL=300

# --- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# or from the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Recurring price of Scan Trade Pro (19,90 €/month).
STRIPE_PRICE_ID=

# --- Transactional e-mail ------------------------------------------------
# Without these, password-reset links are written to the server log instead of
# being e-mailed (usable in development, flagged as an error in production).
RESEND_API_KEY=
MAIL_FROM="Scan Trade <no-reply@example.com>"

# --- Limits --------------------------------------------------------------
# Maximum accepted screenshot size, in bytes (8 MB).
MAX_UPLOAD_BYTES=8388608
# Monthly scan cap per user. 0 = unlimited, which is the MVP plan.
ANALYSIS_MONTHLY_LIMIT=0
# "database" (default, safe on serverless) or "memory" (single process only).
RATE_LIMIT_DRIVER=database
