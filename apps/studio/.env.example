# ---------------------------------------------------------------------------
# Nova Studio — configuration
#
# Copy to .env and fill in what you need. Every value below has a development
# default that keeps the product fully runnable with no external service:
# local disk storage, in-process rendering, no Stripe, no vision API.
#
# Never commit a real secret: this file is the contract, .env is yours.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3100

# PostgreSQL connection string.
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio_dev

# Signs session cookies and local storage URLs. REQUIRED in production.
#   openssl rand -base64 32
AUTH_SECRET=change-me-with-a-32-byte-random-value

# --- Storage ---------------------------------------------------------------
# local: files under STORAGE_LOCAL_DIR, served through signed, expiring URLs.
# s3   : any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage

# Required when STORAGE_DRIVER=s3. Keep the bucket PRIVATE.
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=nova-studio
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_FORCE_PATH_STYLE=true

# --- Rendering -------------------------------------------------------------
# true : videos render inside the web process (development, single machine).
# false: videos are queued and rendered by the dedicated worker (needs REDIS_URL).
INLINE_RENDER=true
# REDIS_URL=redis://localhost:6379

# Chromium used by the Remotion renderer. Leave empty to let Remotion install its own.
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
REMOTION_CONCURRENCY=2

# --- Payments (optional) ---------------------------------------------------
# Without these the product works; only the purchase buttons are disabled.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_CREDITS_10=price_...

# --- Vision (optional) -----------------------------------------------------
# Refines room detection and framing only. The product never generates or alters
# a photo: without a key it falls back to local analysis.
# AI_API_KEY=sk-ant-...
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL=claude-opus-5

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
MAX_IMAGES_PER_LISTING=40
IMPORT_TIMEOUT_MS=12000
IMPORT_USER_AGENT="NovaStudioBot/0.1 (+https://nova.studio/bot; respects robots.txt)"
